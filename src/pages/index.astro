<script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"WebSite","name":"Pharma Job Support","url":"https://pharmajobsupport.com","description":"Pharma proxy job support and pharma proxy interview support platform for clinical research, medical device, and life sciences professionals.","potentialAction":{"@type":"SearchAction","target":{"@type":"EntryPoint","urlTemplate":"https://pharmajobsupport.com/?s={search_term_string}"},"query-input":"required name=search_term_string"}}</script>
<script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"ItemList","name":"Pharma Proxy Support Services","description":"Three core proxy support services for pharma professionals at every career stage.","itemListElement":[{"@type":"ListItem","position":1,"name":"Pharma Proxy Job Support","url":"https://pharmajobsupport.com/pharma-proxy-job-support/","description":"Real-time live job support for working pharma professionals stuck on complex regulated tasks."},{"@type":"ListItem","position":2,"name":"Pharma Proxy Interview Support","url":"https://pharmajobsupport.com/pharma-proxy-interview/","description":"Domain-specific proxy interview preparation and real-time guidance for pharma interview candidates."},{"@type":"ListItem","position":3,"name":"Pharma Profile Engineering","url":"https://pharmajobsupport.com/pharma-profile-engineering/","description":"Profile engineering to help pharma candidates get interview calls through CV positioning and LinkedIn optimization."}]}</script>
<script type="application/ld+json" is:inline>{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What is pharma proxy job support?","acceptedAnswer":{"@type":"Answer","text":"Pharma proxy job support is real-time live guidance provided by a domain expert who walks you through your actual pharma job tasks step by step. It covers clinical SAS, CSV validation, regulatory submissions, Veeva Vault, CAPA, QMS, medical device documentation, and 15+ other pharma domains."}},{"@type":"Question","name":"What is pharma proxy interview support?","acceptedAnswer":{"@type":"Answer","text":"Pharma proxy interview support is real-time domain-specific preparation for your upcoming pharma interview. It includes mock sessions, real technical Q&A for your domain, and live guidance so you are ready for exactly what the interviewer will ask."}},{"@type":"Question","name":"Who is pharma proxy support for?","acceptedAnswer":{"@type":"Answer","text":"Pharma proxy support is for three types of candidates: freshers and certified professionals who are not getting interview calls, candidates with pharma interviews coming up who need preparation, and working professionals already in pharma jobs who need live support on complex regulated tasks."}},{"@type":"Question","name":"What pharma domains do you cover?","acceptedAnswer":{"@type":"Answer","text":"We cover Clinical SAS, CSV Validation, Regulatory Affairs, Pharmacovigilance, Veeva Vault, Medical Device QA, Clinical Data Management, Pharma AI and GenAI, QA and QMS, RPA in Pharma, Cloud and DevOps in Pharma, Pharma BI and Analytics, SAP in Pharma, Pharma Business Analysis, Medical Writing, GRC and Compliance, Clinical Research, and GMP Manufacturing."}},{"@type":"Question","name":"How does a pharma proxy support session work?","acceptedAnswer":{"@type":"Answer","text":"Message us on WhatsApp at +91-9660834611 with your domain and situation. We match you with a pharma domain expert. You work through your task or interview prep together via WhatsApp, call, or screen share. Most sessions happen same-day."}}]}</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<style is:global>
:root {
  --navy-900:#040E1C; --navy-800:#0A1628; --navy-700:#0D3B5E;
  --teal-600:#0E6E8C; --teal-500:#0B9BAA; --teal-400:#009E94; --teal-300:#00BFB3;
  --orange:#E8650A; --orange-h:#C4540A;
  --text-900:#0F1923; --text-700:#1E3448; --text-500:#3D5166; --text-400:#5A6E82;
  --surface-0:#FFFFFF; --surface-50:#F5F8FA; --surface-100:#EBF1F6; --surface-200:#D6E4EE;
  --teal-50:#EBF8F7; --teal-100:#C8EFED;
  --section-pad:88px 5%; --max-w:clamp(1380px, 80vw, 1900px);
  --radius-sm:8px; --radius-md:12px; --radius-lg:18px; --radius-xl:24px;
  --nav-h:68px; --strip-h:40px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;font-size:16px}
body{font-family:'Plus Jakarta Sans',sans-serif;background:var(--surface-0);color:var(--text-500);overflow-x:hidden;line-height:1.7;-webkit-font-smoothing:antialiased}
img{max-width:100%;display:block}
a{text-decoration:none;color:inherit}
ul{list-style:none}
button{font-family:inherit}
.container{max-width:var(--max-w);margin:0 auto;padding:0 5%}
.section-tag{display:inline-block;font-size:.7rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--teal-400);margin-bottom:12px}
.section-tag--light{color:var(--teal-300)}
.sh2{font-size:clamp(1.7rem,2.8vw,2.5rem);font-weight:800;letter-spacing:-.025em;line-height:1.15;color:var(--text-900);margin-bottom:14px}
.sh2 em{font-style:normal;color:var(--teal-400)}
.sh2--light{color:#fff}
.sp{font-size:1rem;font-weight:400;line-height:1.75;color:var(--text-500)}

/* ── HERO ── */
.hero-wrap{position:relative;min-height:100vh;display:flex;flex-direction:column;justify-content:center;overflow:hidden;padding-top:calc(var(--strip-h) + var(--nav-h))}
@media(max-width:960px){.hero-wrap{padding-top:var(--nav-h)}}
.hero-bg{position:absolute;inset:0;z-index:0;background:linear-gradient(148deg,#040E1C 0%,#071829 18%,#0A2540 36%,#0D3B5E 55%,#0E6E8C 75%,#0B9BAA 100%)}
.hero-bg::before{content:'';position:absolute;width:900px;height:900px;top:-200px;right:-250px;background:radial-gradient(circle,rgba(0,191,179,.12) 0%,transparent 65%)}
.hero-bg::after{content:'';position:absolute;width:600px;height:600px;bottom:-100px;left:-120px;background:radial-gradient(circle,rgba(11,154,170,.16) 0%,transparent 62%)}
.hero-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(0,191,179,.03) 1px,transparent 1px),linear-gradient(90deg,rgba(0,191,179,.03) 1px,transparent 1px);background-size:52px 52px}
.hero-content{position:relative;z-index:1;max-width:var(--max-w);margin:0 auto;padding:52px 5% 60px;display:grid;grid-template-columns:1fr 420px;gap:48px;align-items:start}
.hero-urgent{display:inline-flex;align-items:center;gap:8px;background:rgba(0,191,179,.1);border:1px solid rgba(0,191,179,.28);border-radius:100px;padding:5px 14px 5px 10px;margin-bottom:20px;width:fit-content}
.udot{width:7px;height:7px;border-radius:50%;background:var(--teal-300);flex-shrink:0}
.utxt{font-size:.69rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--teal-300)}
.hero-h1{font-size:clamp(1.65rem,2.85vw,2.75rem);font-weight:800;line-height:1.2;letter-spacing:-.025em;color:#fff;margin-bottom:18px}
.hero-h1 .h1-line:first-child{font-size:.84em;font-weight:600;color:#fff;margin-bottom:4px}
.h1-line{display:block}
.h1-orange{color:var(--teal-300);font-weight:800}
.hero-h1 .grad{background:linear-gradient(92deg,#7FFFFA 0%,#00BFB3 50%,#57EDE3 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;display:block;font-size:clamp(.92rem,1.6vw,1.38rem);margin-top:10px;margin-bottom:5px;letter-spacing:.01em;font-weight:700}
.hero-domains{display:block;font-size:clamp(.84rem,1.2vw,.98rem);font-weight:500;color:rgba(255,255,255,.62);margin-top:6px;letter-spacing:.01em;line-height:1.6;border-top:1px solid rgba(255,255,255,.08);padding-top:8px}
.hero-hook{display:flex;align-items:center;justify-content:space-between;gap:12px;background:rgba(0,191,179,.1);border:1px solid rgba(0,191,179,.25);border-radius:10px;padding:10px 14px;margin-bottom:16px;flex-wrap:wrap}
.hero-hook-txt{font-size:.8rem;font-weight:500;color:rgba(255,255,255,.9);display:flex;align-items:center;gap:8px}
.hero-hook-txt svg{width:14px;height:14px;color:var(--teal-300);flex-shrink:0}
.hero-hook-cta{font-size:.76rem;font-weight:700;color:var(--teal-300);white-space:nowrap;text-decoration:none;border:1px solid rgba(0,191,179,.4);padding:5px 11px;border-radius:6px;transition:background .2s;flex-shrink:0}
.hero-hook-cta:hover{background:rgba(0,191,179,.15)}
.hero-lead{font-size:.9rem;font-weight:400;line-height:1.78;color:rgba(255,255,255,.78);margin-bottom:14px}
.hero-pains{list-style:none;display:flex;flex-direction:column;gap:7px;margin-bottom:22px}
.hero-pains li{display:flex;align-items:flex-start;gap:9px;font-size:.83rem;color:rgba(255,255,255,.78);line-height:1.55;font-weight:500}
.hero-pains li::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--teal-300);flex-shrink:0;margin-top:6px}
.hero-trust-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:24px;padding:12px 14px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:8px}
.htr-item{display:flex;align-items:center;gap:5px;font-size:.76rem;color:rgba(255,255,255,.8);font-weight:500}
.htr-item svg{width:13px;height:13px;color:var(--teal-400);flex-shrink:0}
.htr-sep{width:1px;height:13px;background:rgba(255,255,255,.18);flex-shrink:0}
.hero-btns{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:16px}
.btn-wa{display:inline-flex;align-items:center;gap:8px;background:#1DAA61;color:#fff;font-size:.9rem;font-weight:700;padding:13px 26px;border-radius:7px;border:none;cursor:pointer;transition:background .2s,transform .15s,box-shadow .2s;box-shadow:0 4px 24px rgba(29,170,97,.5);text-decoration:none;white-space:nowrap}
.btn-wa:hover{background:#18954f;transform:translateY(-2px);box-shadow:0 8px 28px rgba(29,170,97,.55);color:#fff}
.btn-wa svg{width:16px;height:16px;flex-shrink:0}
.btn-ghost{display:inline-flex;align-items:center;gap:8px;background:transparent;color:rgba(255,255,255,.85);font-size:.87rem;font-weight:600;padding:11px 20px;border-radius:7px;border:1.5px solid rgba(255,255,255,.28);cursor:pointer;transition:border-color .2s,background .2s;text-decoration:none;white-space:nowrap}
.btn-ghost:hover{border-color:rgba(255,255,255,.55);background:rgba(255,255,255,.07);color:#fff}
.btn-ghost svg{width:15px;height:15px;flex-shrink:0}
.btn-arrow{display:inline-flex;align-items:center;gap:7px;font-size:.87rem;font-weight:700;color:var(--orange);text-decoration:none;padding:11px 20px;border-radius:7px;border:1.5px solid rgba(232,101,10,.5);transition:background .2s,border-color .2s;white-space:nowrap}
.btn-arrow:hover{background:rgba(232,101,10,.12);border-color:var(--orange);color:var(--orange)}
.hero-foot{font-size:.73rem;color:rgba(255,255,255,.48)}
.hero-foot strong{color:rgba(255,255,255,.68)}
.hcard{background:linear-gradient(145deg,#071829 0%,#0d3b5e 60%,#0e5a7a 100%);border:1px solid rgba(0,191,179,.3);border-radius:16px;overflow:hidden;box-shadow:0 24px 64px rgba(0,0,0,.5)}
.hcard-top{background:rgba(0,0,0,.35);border-bottom:1px solid rgba(0,191,179,.2);padding:12px 18px;display:flex;align-items:center;gap:8px;font-size:.67rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.9)}
.hlive-dot{width:7px;height:7px;border-radius:50%;background:var(--teal-300);flex-shrink:0}
.hcard-stats{display:grid;grid-template-columns:1fr 1fr;border-bottom:1px solid rgba(255,255,255,.08)}
.hstat{padding:15px 18px;border-right:1px solid rgba(255,255,255,.08)}
.hstat:nth-child(2n){border-right:none}
.hstat:nth-child(1),.hstat:nth-child(2){border-bottom:1px solid rgba(255,255,255,.08)}
.hstat-num{font-size:1.6rem;font-weight:800;letter-spacing:-.04em;color:var(--teal-300);line-height:1;margin-bottom:3px}
.hstat-num sup{font-size:.8rem;color:var(--teal-400);font-weight:700}
.hstat-lbl{font-size:.71rem;font-weight:500;color:rgba(255,255,255,.68);line-height:1.35}
.hcard-experts{padding:15px 18px;border-bottom:1px solid rgba(255,255,255,.08)}
.hcard-expert-hdr{display:flex;align-items:flex-start;justify-content:space-between;gap:8px;margin-bottom:5px}
.hcard-expert-title{font-size:.81rem;font-weight:700;color:#fff;line-height:1.4;flex:1}
.hlive-badge{background:rgba(0,191,179,.18);color:var(--teal-300);border:1px solid rgba(0,191,179,.35);font-size:.61rem;font-weight:700;padding:2px 7px;border-radius:4px;white-space:nowrap;flex-shrink:0;letter-spacing:.05em;text-transform:uppercase;margin-top:1px}
.hcard-expert-sub{font-size:.72rem;color:rgba(255,255,255,.5);margin-bottom:10px;line-height:1.4}
.hcard-tags{display:flex;flex-wrap:wrap;gap:5px}
.hcard-tag{font-size:.68rem;font-weight:600;padding:4px 9px;border-radius:5px;background:rgba(0,191,179,.12);color:var(--teal-300);border:1px solid rgba(0,191,179,.25)}
.hcard-feats{padding:12px 18px;border-bottom:1px solid rgba(255,255,255,.08);display:flex;flex-wrap:wrap;gap:5px}
.hcard-feat{font-size:.68rem;font-weight:600;padding:4px 10px;border-radius:5px;background:rgba(0,191,179,.1);color:var(--teal-300);border:1px solid rgba(0,191,179,.22);display:flex;align-items:center;gap:4px}
.hcard-feat svg{width:10px;height:10px;color:var(--teal-400);flex-shrink:0}
.hcard-cta{padding:14px 18px;display:flex;flex-direction:column;gap:8px}
.hcard-cta-main{display:flex;align-items:center;justify-content:center;gap:8px;background:#1DAA61;color:#fff;font-size:.84rem;font-weight:700;padding:11px;border-radius:8px;text-decoration:none;transition:background .2s}
.hcard-cta-main:hover{background:#18954f;color:#fff}
.hcard-cta-main svg{width:15px;height:15px;flex-shrink:0}
.hcard-cta-row{display:flex;gap:7px}
.hcard-cta-sec{flex:1;display:flex;align-items:center;justify-content:center;gap:6px;background:rgba(255,255,255,.08);color:rgba(255,255,255,.88);font-size:.78rem;font-weight:700;padding:9px;border-radius:8px;border:1px solid rgba(255,255,255,.18);text-decoration:none;transition:background .2s;white-space:nowrap}
.hcard-cta-sec:hover{background:rgba(255,255,255,.15);color:#fff}
.hcard-cta-sec svg{width:13px;height:13px;flex-shrink:0}

/* ── STATS ── */
.stats-section{background:var(--surface-0);border-bottom:1px solid var(--surface-200)}
.stats-inner{max-width:var(--max-w);margin:0 auto;padding:0 5%;display:grid;grid-template-columns:repeat(4,1fr)}
.stat-col{padding:34px 22px;border-right:1px solid var(--surface-200);transition:background .2s}
.stat-col:last-child{border-right:none}
.stat-col:hover{background:var(--teal-50)}
.stat-ico{width:30px;height:30px;margin-bottom:10px;color:var(--teal-400)}
.stat-num{font-size:2.2rem;font-weight:800;letter-spacing:-.04em;color:var(--navy-700);line-height:1;margin-bottom:5px}
.stat-num sup{font-size:1rem;color:var(--teal-400)}
.stat-lbl{font-size:.82rem;font-weight:500;color:var(--text-400);line-height:1.4}

/* ── TRUST BAR ── */
.trust-bar{background:var(--teal-50);border-bottom:1px solid var(--teal-100);padding:13px 0;overflow:hidden}
.trust-track{display:flex;align-items:center;gap:36px;animation:scroll-t 35s linear infinite;width:max-content}
.trust-track:hover{animation-play-state:paused}
@keyframes scroll-t{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
.tbar-item{display:flex;align-items:center;gap:7px;white-space:nowrap;font-size:.82rem;font-weight:600;color:var(--teal-600)}
.tbar-item svg{width:13px;height:13px;flex-shrink:0;color:var(--teal-400)}
.tbar-div{width:1px;height:14px;background:var(--teal-100);flex-shrink:0}

/* ── OFFER SECTION ── */
.offer-section{background:var(--surface-0);padding:var(--section-pad);border-top:1px solid var(--surface-200)}
.offer-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:40px}
.offer-card{background:var(--surface-0);border:1.5px solid var(--surface-200);border-radius:var(--radius-lg);padding:28px 24px;transition:border-color .2s,box-shadow .2s,transform .2s;position:relative;overflow:hidden}
.offer-card::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,var(--teal-400),var(--teal-300));opacity:0;transition:opacity .2s}
.offer-card:hover{border-color:var(--teal-300);box-shadow:0 8px 32px rgba(0,159,148,.1);transform:translateY(-3px)}
.offer-card:hover::before{opacity:1}
.offer-ico{width:50px;height:50px;border-radius:12px;background:var(--teal-50);border:1px solid var(--teal-100);display:flex;align-items:center;justify-content:center;margin-bottom:18px;color:var(--teal-600)}
.offer-ico svg{width:24px;height:24px}
.offer-title{font-size:1.05rem;font-weight:700;color:var(--text-900);line-height:1.3;margin-bottom:9px;letter-spacing:-.01em}
.offer-desc{font-size:.875rem;color:var(--text-500);line-height:1.68;margin-bottom:16px}
.offer-items{display:flex;flex-direction:column;gap:7px;margin-bottom:20px}
.offer-item{display:flex;align-items:center;gap:8px;font-size:.81rem;color:var(--text-700);font-weight:500}
.offer-item svg{width:14px;height:14px;color:var(--teal-400);flex-shrink:0}
.offer-cta{display:inline-flex;align-items:center;gap:6px;font-size:.83rem;font-weight:700;color:var(--teal-400);transition:gap .2s,color .2s}
.offer-cta:hover{gap:10px;color:var(--teal-600)}
.offer-cta svg{width:15px;height:15px}

/* ── DOMAINS SECTION ── */
.domains-section{background:var(--surface-50);border-top:1px solid var(--surface-200);border-bottom:1px solid var(--surface-200);padding:var(--section-pad)}
.domains-hdr{max-width:600px;margin-bottom:40px}
.domains-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.domain-card{background:var(--surface-0);border:1.5px solid var(--surface-200);border-radius:var(--radius-md);overflow:hidden;transition:border-color .2s,box-shadow .2s}
.domain-card:hover{border-color:rgba(0,191,179,.4);box-shadow:0 4px 16px rgba(0,159,148,.08)}
.domain-card.expanded{border-color:var(--teal-300)}
.domain-hdr{display:flex;align-items:center;gap:13px;padding:15px 17px;cursor:pointer;user-select:none}
.domain-ico{width:38px;height:38px;flex-shrink:0;border-radius:9px;background:var(--teal-50);border:1px solid var(--teal-100);display:flex;align-items:center;justify-content:center;color:var(--teal-600)}
.domain-ico svg{width:19px;height:19px}
.domain-name{flex:1;font-size:.88rem;font-weight:700;color:var(--text-900);line-height:1.3}
.domain-tog{width:21px;height:21px;flex-shrink:0;border-radius:50%;background:var(--surface-100);display:flex;align-items:center;justify-content:center;transition:background .2s,transform .25s;color:var(--text-400)}
.domain-tog svg{width:11px;height:11px}
.domain-card.expanded .domain-tog{background:var(--teal-50);transform:rotate(180deg);color:var(--teal-600)}
.domain-body{display:none;padding:0 17px 17px;border-top:1px solid var(--surface-100)}
.domain-card.expanded .domain-body{display:block;padding-top:13px}
.domain-desc{font-size:.82rem;color:var(--text-500);line-height:1.65;margin-bottom:11px}
.domain-tags{display:flex;flex-wrap:wrap;gap:5px}
.domain-tag{font-size:.71rem;font-weight:600;background:var(--teal-50);color:var(--teal-600);border:1px solid var(--teal-100);border-radius:4px;padding:3px 8px}
.domain-cta{display:inline-flex;align-items:center;gap:5px;margin-top:11px;font-size:.79rem;font-weight:700;color:var(--orange);transition:gap .2s}
.domain-cta:hover{gap:9px}
.domain-cta svg{width:13px;height:13px}

/* ── DIRECT SECTION ── */
.direct-section{background:var(--navy-800);padding:var(--section-pad)}
.direct-inner{max-width:var(--max-w);margin:0 auto;padding:0 5%;display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
.direct-pills{display:flex;flex-wrap:wrap;gap:9px;margin-top:26px}
.dpill{display:flex;align-items:center;gap:7px;padding:7px 14px;background:rgba(0,191,179,.1);border:1px solid rgba(0,191,179,.2);border-radius:100px;font-size:.81rem;font-weight:600;color:var(--teal-300)}
.dpill svg{width:13px;height:13px}
.direct-pts{display:flex;flex-direction:column;gap:14px}
.dpt{display:flex;gap:15px;align-items:flex-start;padding:17px 19px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.08);border-radius:var(--radius-md);transition:background .2s,border-color .2s}
.dpt:hover{background:rgba(0,191,179,.07);border-color:rgba(0,191,179,.18)}
.dpt-ico{width:36px;height:36px;flex-shrink:0;border-radius:9px;background:rgba(0,191,179,.12);display:flex;align-items:center;justify-content:center;color:var(--teal-300)}
.dpt-ico svg{width:17px;height:17px}
.dpt-title{font-size:.88rem;font-weight:700;color:#fff;margin-bottom:3px}
.dpt-desc{font-size:.81rem;color:rgba(255,255,255,.52);line-height:1.55}

/* ── CAREER TIERS ── */
.career-section{background:var(--surface-0);padding:var(--section-pad);border-top:1px solid var(--surface-200)}
.career-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:40px}
.career-card{background:var(--surface-50);border:1.5px solid var(--surface-200);border-radius:var(--radius-lg);padding:26px 22px;transition:border-color .2s,box-shadow .2s,transform .2s;display:flex;flex-direction:column}
.career-card.featured{background:linear-gradient(145deg,var(--navy-800),var(--navy-700));border-color:var(--teal-400);box-shadow:0 8px 32px rgba(0,159,148,.2)}
.career-card:hover{transform:translateY(-3px)}
.career-card:not(.featured):hover{border-color:var(--teal-300);box-shadow:0 8px 24px rgba(0,159,148,.1)}
.career-badge{display:inline-block;font-size:.67rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:4px 10px;border-radius:4px;margin-bottom:15px;align-self:flex-start}
.cb--pop{background:rgba(232,101,10,.15);color:var(--orange);border:1px solid rgba(232,101,10,.25)}
.cb--start{background:var(--teal-50);color:var(--teal-600);border:1px solid var(--teal-100)}
.cb--full{background:rgba(0,191,179,.1);color:var(--teal-300);border:1px solid rgba(0,191,179,.2)}
.career-ico{width:46px;height:46px;border-radius:11px;display:flex;align-items:center;justify-content:center;margin-bottom:15px}
.career-card:not(.featured) .career-ico{background:var(--teal-50);border:1px solid var(--teal-100);color:var(--teal-600)}
.career-card.featured .career-ico{background:rgba(0,191,179,.15);color:var(--teal-300)}
.career-ico svg{width:23px;height:23px}
.career-title{font-size:1.03rem;font-weight:700;margin-bottom:8px;letter-spacing:-.01em}
.career-card:not(.featured) .career-title{color:var(--text-900)}
.career-card.featured .career-title{color:#fff}
.career-desc{font-size:.83rem;line-height:1.65;margin-bottom:16px;flex:1}
.career-card:not(.featured) .career-desc{color:var(--text-500)}
.career-card.featured .career-desc{color:rgba(255,255,255,.62)}
.career-items{display:flex;flex-direction:column;gap:7px;margin-bottom:22px}
.career-item{display:flex;align-items:center;gap:8px;font-size:.81rem;font-weight:500}
.career-card:not(.featured) .career-item{color:var(--text-700)}
.career-card.featured .career-item{color:rgba(255,255,255,.8)}
.career-item svg{width:13px;height:13px;flex-shrink:0}
.career-card:not(.featured) .career-item svg{color:var(--teal-400)}
.career-card.featured .career-item svg{color:var(--teal-300)}
.career-cta{display:flex;align-items:center;justify-content:center;gap:8px;padding:11px;border-radius:8px;font-size:.86rem;font-weight:700;cursor:pointer;transition:all .2s;border:none;text-decoration:none}
.cc--primary{background:var(--orange);color:#fff}
.cc--primary:hover{background:var(--orange-h)}
.cc--outline{background:transparent;border:1.5px solid var(--surface-200);color:var(--text-700)}
.cc--outline:hover{border-color:var(--teal-300);color:var(--teal-600)}

/* ── HOW IT WORKS ── */
.how-section{background:var(--surface-50);border-top:1px solid var(--surface-200);border-bottom:1px solid var(--surface-200);padding:var(--section-pad)}
.how-inner{max-width:var(--max-w);margin:0 auto;padding:0 5%}
.steps-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:0;margin-top:48px;position:relative}
.steps-grid::before{content:'';position:absolute;top:27px;left:calc(12.5% + 18px);right:calc(12.5% + 18px);height:2px;background:linear-gradient(90deg,var(--teal-400),var(--teal-300));z-index:0}
.step-block{display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 18px;position:relative;z-index:1}
.step-num{width:54px;height:54px;border-radius:50%;background:linear-gradient(135deg,var(--navy-700),var(--teal-600));color:#fff;font-size:1.05rem;font-weight:800;display:flex;align-items:center;justify-content:center;margin-bottom:18px;box-shadow:0 4px 16px rgba(13,59,94,.3);flex-shrink:0}
.step-ico{margin-bottom:11px;color:var(--teal-400)}
.step-ico svg{width:26px;height:26px}
.step-title{font-size:.93rem;font-weight:700;color:var(--text-900);margin-bottom:7px;letter-spacing:-.01em}
.step-desc{font-size:.81rem;color:var(--text-500);line-height:1.65}
.how-urgent{margin-top:38px;padding:17px 22px;background:rgba(232,101,10,.06);border:1px solid rgba(232,101,10,.18);border-radius:var(--radius-md);display:flex;align-items:center;gap:13px}
.how-urgent svg{width:19px;height:19px;color:var(--orange);flex-shrink:0}
.how-urgent-txt{font-size:.88rem;font-weight:600;color:var(--text-700)}
.how-urgent-txt strong{color:var(--orange)}
.how-urgent-txt a{color:var(--orange);font-weight:700}

/* ── LEGACY ── */
.legacy-section{background:var(--navy-900);padding:var(--section-pad)}
.legacy-inner{max-width:var(--max-w);margin:0 auto;padding:0 5%}
.legacy-timeline{display:grid;grid-template-columns:repeat(5,1fr);gap:0;margin-top:48px;position:relative}
.legacy-timeline::before{content:'';position:absolute;top:21px;left:10%;right:10%;height:2px;background:linear-gradient(90deg,var(--teal-600),var(--teal-300),var(--teal-600))}
.legacy-item{display:flex;flex-direction:column;align-items:center;text-align:center;padding:0 10px;position:relative;z-index:1}
.legacy-dot{width:42px;height:42px;border-radius:50%;background:var(--navy-800);border:2px solid var(--teal-400);display:flex;align-items:center;justify-content:center;margin-bottom:15px;color:var(--teal-300)}
.legacy-dot svg{width:17px;height:17px}
.legacy-year{font-size:.72rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:var(--teal-300);margin-bottom:5px}
.legacy-title{font-size:.81rem;font-weight:700;color:#fff;line-height:1.35;margin-bottom:5px}
.legacy-desc{font-size:.73rem;color:rgba(255,255,255,.42);line-height:1.55}
.legacy-ctas{display:flex;gap:12px;margin-top:44px;justify-content:center;flex-wrap:wrap}

/* ── TESTIMONIALS ── */
.proof-section{background:var(--surface-0);padding:var(--section-pad);border-top:1px solid var(--surface-200)}
.proof-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px;margin-top:40px}
.proof-card{background:var(--surface-50);border:1.5px solid var(--surface-200);border-radius:var(--radius-lg);padding:24px 21px;transition:border-color .2s,box-shadow .2s,transform .2s}
.proof-card:hover{border-color:var(--teal-300);box-shadow:0 6px 24px rgba(0,159,148,.1);transform:translateY(-2px)}
.stars{display:flex;gap:2px;margin-bottom:13px}
.star{width:15px;height:15px;color:#F59E0B}
.proof-quote{font-size:.87rem;color:var(--text-700);line-height:1.72;margin-bottom:17px;font-style:italic}
.proof-author{display:flex;align-items:center;gap:10px}
.author-av{width:38px;height:38px;border-radius:50%;flex-shrink:0;background:linear-gradient(135deg,var(--teal-500),var(--navy-700));display:flex;align-items:center;justify-content:center;font-size:.76rem;font-weight:800;color:#fff}
.author-name{font-size:.84rem;font-weight:700;color:var(--text-900)}
.author-role{font-size:.73rem;color:var(--text-400);margin-top:1px}
.author-loc{font-size:.71rem;color:var(--teal-400);font-weight:600}

/* ── URGENCY ── */
.urgency-section{background:linear-gradient(145deg,var(--navy-900),#0a0f1e);padding:var(--section-pad);position:relative;overflow:hidden}
.urgency-section::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#DC2626,#E8650A,var(--teal-400))}
.urgency-inner{max-width:var(--max-w);margin:0 auto;padding:0 5%}
.urgency-grid{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:start}
.urgency-label{display:inline-flex;align-items:center;gap:7px;background:rgba(220,38,38,.12);border:1px solid rgba(220,38,38,.25);border-radius:100px;padding:4px 12px;font-size:.67rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#FCA5A5;margin-bottom:15px}
.urgency-h2{font-size:clamp(1.6rem,2.5vw,2.2rem);font-weight:800;line-height:1.18;letter-spacing:-.025em;color:#fff;margin-bottom:15px}
.urgency-lead{font-size:.93rem;color:rgba(255,255,255,.62);line-height:1.72;margin-bottom:30px}
.urgency-ctas{display:flex;flex-wrap:wrap;gap:11px}
.pain-grid{display:flex;flex-direction:column;gap:9px}
.pain-row{display:flex;align-items:flex-start;gap:11px;padding:13px 15px;background:rgba(220,38,38,.07);border:1px solid rgba(220,38,38,.15);border-radius:var(--radius-md);transition:background .2s,border-color .2s}
.pain-row:hover{background:rgba(220,38,38,.12);border-color:rgba(220,38,38,.25)}
.pain-ico{color:#EF4444;flex-shrink:0;margin-top:1px}
.pain-ico svg{width:15px;height:15px}
.pain-txt{font-size:.83rem;color:rgba(255,255,255,.8);line-height:1.55;font-weight:400}
.pain-txt strong{color:#FCA5A5;font-weight:700}

/* ── PROFILE CTA ── */
.profile-section{background:var(--surface-50);padding:var(--section-pad);border-top:1px solid var(--surface-200);border-bottom:1px solid var(--surface-200)}
.profile-inner{max-width:var(--max-w);margin:0 auto;padding:0 5%}
.profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
.profile-feats{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin-top:26px}
.pf-item{display:flex;align-items:flex-start;gap:9px;padding:13px;background:var(--surface-0);border:1px solid var(--surface-200);border-radius:var(--radius-md);transition:border-color .2s}
.pf-item:hover{border-color:var(--teal-300)}
.pf-ico{width:30px;height:30px;flex-shrink:0;border-radius:7px;background:var(--teal-50);border:1px solid var(--teal-100);display:flex;align-items:center;justify-content:center;color:var(--teal-600)}
.pf-ico svg{width:15px;height:15px}
.pf-label{font-size:.79rem;font-weight:700;color:var(--text-900);line-height:1.35}
.profile-box{background:linear-gradient(145deg,var(--navy-800),var(--navy-700));border-radius:var(--radius-xl);padding:34px 30px;border:1px solid rgba(255,255,255,.08)}
.pbox-lbl{font-size:.67rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--teal-300);margin-bottom:7px}
.pbox-title{font-size:1.28rem;font-weight:800;color:#fff;line-height:1.3;margin-bottom:11px;letter-spacing:-.02em}
.pbox-desc{font-size:.86rem;color:rgba(255,255,255,.58);line-height:1.68;margin-bottom:22px}
.pbox-stats{display:grid;grid-template-columns:1fr 1fr;gap:11px;margin-bottom:22px}
.pbox-stat{text-align:center;padding:12px;background:rgba(0,191,179,.08);border:1px solid rgba(0,191,179,.15);border-radius:8px}
.pbox-stat-num{font-size:1.45rem;font-weight:800;color:var(--teal-300);line-height:1;margin-bottom:4px}
.pbox-stat-lbl{font-size:.71rem;font-weight:500;color:rgba(255,255,255,.48)}
.btn-outline-white{display:inline-flex;align-items:center;gap:7px;background:transparent;color:rgba(255,255,255,.82);font-size:.86rem;font-weight:600;padding:11px 22px;border-radius:7px;border:1.5px solid rgba(255,255,255,.22);cursor:pointer;transition:border-color .2s,background .2s;text-decoration:none}
.btn-outline-white:hover{border-color:rgba(255,255,255,.5);background:rgba(255,255,255,.07)}

/* ── FAQ ── */
.faq-section{background:var(--surface-0);padding:var(--section-pad);border-top:1px solid var(--surface-200)}
.faq-inner{max-width:780px;margin:0 auto;padding:0 5%}
.faq-list{margin-top:38px;display:flex;flex-direction:column;gap:9px}
.faq-item{border:1.5px solid var(--surface-200);border-radius:var(--radius-md);overflow:hidden;transition:border-color .2s}
.faq-item.open{border-color:var(--teal-300)}
.faq-q{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:17px 21px;cursor:pointer;font-size:.93rem;font-weight:700;color:var(--text-900);background:var(--surface-0);user-select:none;transition:background .2s}
.faq-q:hover{background:var(--teal-50)}
.faq-item.open .faq-q{background:var(--teal-50);color:var(--navy-700)}
.faq-tog{width:24px;height:24px;flex-shrink:0;border-radius:50%;background:var(--surface-100);display:flex;align-items:center;justify-content:center;transition:transform .25s,background .2s;color:var(--text-400)}
.faq-tog svg{width:13px;height:13px}
.faq-item.open .faq-tog{transform:rotate(180deg);background:var(--teal-100);color:var(--teal-600)}
.faq-a{display:none;padding:4px 21px 17px;font-size:.87rem;color:var(--text-500);line-height:1.75}
.faq-item.open .faq-a{display:block}
.faq-ctas{display:flex;gap:12px;margin-top:30px;justify-content:center;flex-wrap:wrap}

/* ── CTA STRIP ── */
.cta-strip{background:linear-gradient(120deg,var(--navy-800) 0%,var(--navy-700) 100%);padding:60px 5%;position:relative;overflow:hidden}
.cta-strip::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--teal-400),var(--orange))}
.cta-strip-inner{max-width:var(--max-w);margin:0 auto;display:grid;grid-template-columns:1fr auto;gap:40px;align-items:center}
.strip-h{font-size:clamp(1.4rem,2.2vw,2rem);font-weight:800;letter-spacing:-.022em;color:#fff;margin-bottom:8px;line-height:1.2}
.strip-p{font-size:.92rem;color:rgba(255,255,255,.6);line-height:1.65}
.strip-btns{display:flex;flex-direction:column;gap:9px;align-items:flex-end}

/* ── WA FLOAT ── */
.wa-float{position:fixed;bottom:24px;right:24px;z-index:900;display:flex;align-items:center;gap:9px;background:#1DAA61;color:#fff;font-size:.84rem;font-weight:700;padding:12px 19px 12px 14px;border-radius:50px;box-shadow:0 6px 24px rgba(29,170,97,.48);transition:transform .2s,box-shadow .2s;animation:fadeUp .6s ease 1s both}
@media(max-width:767px){.wa-float{display:none}}
.wa-float:hover{transform:translateY(-3px);box-shadow:0 10px 32px rgba(29,170,97,.58)}
.wa-float svg{width:20px;height:20px;flex-shrink:0}

/* ── RESPONSIVE ── */
@media(max-width:1100px){
  .legacy-timeline{grid-template-columns:repeat(3,1fr)}
  .legacy-timeline::before{display:none}
}
@media(max-width:960px){
  .nav-center{display:none}
  .btn-call{display:none}
  .hamburger{display:flex}
  .hero-content{grid-template-columns:1fr}
  .hcard{display:none}
  .offer-grid{grid-template-columns:1fr 1fr}
  .domains-grid{grid-template-columns:1fr 1fr}
  .career-grid{grid-template-columns:1fr 1fr}
  .steps-grid{grid-template-columns:1fr 1fr;gap:32px}
  .steps-grid::before{display:none}
  .urgency-grid{grid-template-columns:1fr}
  .profile-grid{grid-template-columns:1fr}
  .direct-inner{grid-template-columns:1fr;gap:40px}
  .cta-strip-inner{grid-template-columns:1fr}
  .strip-btns{align-items:flex-start;flex-direction:row;flex-wrap:wrap}
}
@media(max-width:640px){
  :root{--section-pad:60px 5%}
  .offer-grid{grid-template-columns:1fr}
  .domains-grid{grid-template-columns:1fr}
  .career-grid{grid-template-columns:1fr}
  .stats-inner{grid-template-columns:1fr 1fr}
  .stat-col:nth-child(1),.stat-col:nth-child(2){border-bottom:1px solid var(--surface-200)}
  .stat-col:nth-child(2){border-right:none}
  .steps-grid{grid-template-columns:1fr}
  .proof-grid{grid-template-columns:1fr}
  .legacy-timeline{grid-template-columns:1fr 1fr}
  .profile-feats{grid-template-columns:1fr}
  .hero-h1{font-size:2rem}
}
@media(max-width:400px){
  .pbox-stats{grid-template-columns:1fr}
}
</style>
