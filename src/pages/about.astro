---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABanner from '../components/CTABanner.astro';
import { site } from '../data/site';
import { buildBreadcrumbSchema } from '../utils/schema';

const schema = buildBreadcrumbSchema([
  { name: 'Home', url: site.url + '/' },
  { name: 'About', url: site.url + '/about/' },
]);
---

<BaseLayout
  title="About PharmaCDM | Pharma Proxy Job Support Experts"
  description="Learn about PharmaCDM — our domain experts, pharma industry experience, and commitment to supporting pharmaceutical professionals globally."
  schema={schema}
>
  <div class="about-container">
    <Breadcrumbs crumbs={[{ label: 'About' }]} />

    <header class="about-hero">
      <h1>About PharmaCDM Job Support</h1>
      <p class="about-tagline">Expert Pharma Proxy Job Support — Built by Industry Professionals, for Industry Professionals</p>
    </header>

    <div class="about-body">
      <section>
        <h2>What We Do</h2>
        <p>
          PharmaCDM (pharmajobsupport.com) provides expert real-time proxy job support for pharmaceutical industry professionals. Our specialists have hands-on experience in clinical data management, pharmacovigilance, regulatory affairs, computer system validation, quality assurance, medical device, and related GxP disciplines.
        </p>
        <p>
          We bridge the gap between where professionals are today and where their new role requires them to be — providing domain-specific guidance on tasks, deliverables, regulatory requirements, and system workflows that make the difference between struggling and succeeding.
        </p>
      </section>

      <section>
        <h2>Our Expertise Areas</h2>
        <ul class="expertise-list" role="list">
          <li>Clinical SAS Programming — SDTM, ADaM, TLF generation, Pinnacle 21, FDA submission programming</li>
          <li>Pharmacovigilance — ICSR processing, Argus Safety, MedDRA coding, EudraVigilance, PSUR/PBRER</li>
          <li>Regulatory Affairs — eCTD submissions, NDA/BLA/MAA preparation, Veeva Vault RIM, FDA/EMA strategy</li>
          <li>Computer System Validation — 21 CFR Part 11, EU Annex 11, GAMP 5, IQ/OQ/PQ protocols</li>
          <li>Clinical Data Management — Medidata Rave, Oracle InForm, CDASH, MedDRA, database lock</li>
          <li>Quality Assurance / GMP — CAPA, deviation management, GMP audit readiness, ICH Q10</li>
          <li>Medical Device QA — ISO 13485, EU MDR, FDA 510(k), PMA, ISO 14971 risk management</li>
          <li>Veeva Vault — QMS, eTMF, RIM, Safety, EDC configuration and validation</li>
          <li>Pharma AI / ML — drug discovery AI, pharmacovigilance automation, regulatory AI applications</li>
          <li>Interview Preparation — technical domain questions, scenario-based preparation, mock interviews</li>
        </ul>
      </section>

      <section>
        <h2>Our Commitment</h2>
        <p>
          Every support session is delivered by a specialist with direct, recent pharmaceutical industry experience — not a generalist tutor working from textbooks. Our experts have held roles at CROs, large pharma companies, regulatory consulting firms, and medical device manufacturers.
        </p>
        <p>
          We are committed to complete confidentiality. We never contact your employer, retain project information beyond your session, or share any details of your engagement. All support is encrypted and subject to strict NDAs.
        </p>
      </section>

      <section>
        <h2>Global Reach</h2>
        <p>
          We support pharma professionals in 30+ countries across every major pharmaceutical market: USA (New Jersey, Boston, San Francisco, Chicago), UK (London, Cambridge, Oxford), EU (Basel, Amsterdam, Zurich, Munich), APAC (Singapore, Tokyo, Sydney, Bangalore), Middle East (Dubai, Abu Dhabi, Riyadh), and India (Bangalore, Hyderabad, Mumbai, Pune).
        </p>
      </section>

      <section>
        <h2>Contact Us</h2>
        <p>
          WhatsApp: <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">{site.whatsapp}</a><br />
          Email: <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </section>
    </div>
  </div>

  <CTABanner />
</BaseLayout>

<style>
  .about-container {
    max-width: 56rem;
    margin: 0 auto;
    padding: 0 5% var(--space-14);
  }
  .about-hero { padding: var(--space-10) 0 var(--space-8); border-bottom: 1px solid var(--color-border); margin-bottom: var(--space-10); }
  .about-hero h1 { font-size: clamp(1.75rem, 3.5vw, 2.5rem); font-weight: 800; margin-bottom: var(--space-4); }
  .about-tagline { font-size: 1.1rem; color: var(--color-muted); font-style: italic; }
  .about-body { display: flex; flex-direction: column; gap: var(--space-10); }
  .about-body section h2 { font-size: 1.25rem; font-weight: 700; margin-bottom: var(--space-4); color: var(--color-text); }
  .about-body section p { font-size: 0.9375rem; color: var(--color-muted); line-height: 1.75; }
  .about-body section p + p { margin-top: var(--space-4); }
  .expertise-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .expertise-list li {
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--color-primary);
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.5;
  }
</style>
