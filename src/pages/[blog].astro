---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CTABanner from '../components/CTABanner.astro';
import FAQ from '../components/FAQ.astro';
import { site } from '../data/site';
import { buildBreadcrumbSchema, buildFAQSchema, buildArticleSchema } from '../utils/schema';
import { allBlogs } from '../data/blogs-index';

export function getStaticPaths() {
  return allBlogs.map((entry) => ({
    params: { blog: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;

const breadcrumbItems = [
  { name: 'Home', url: site.url + '/' },
  { name: 'Blog', url: site.url + '/blog/' },
  { name: entry.title, url: site.url + '/' + entry.slug + '/' },
];

const schemas = [
  buildArticleSchema(
    entry.title,
    entry.metaDesc,
    site.url + '/' + entry.slug + '/',
    entry.publishDate,
  ),
  buildBreadcrumbSchema(breadcrumbItems),
  buildFAQSchema(entry.faqs.map(f => ({ question: f.q, answer: f.a }))),
];
---

<BaseLayout
  title={entry.metaTitle}
  description={entry.metaDesc}
  schema={schemas}
>
  <div class="page-container">
    <Breadcrumbs crumbs={[
      { label: 'Blog', href: '/blog/' },
      { label: entry.title }
    ]} />

    <header class="page-hero">
      <div class="hero-badge">{entry.category}</div>
      <h1>{entry.title}</h1>
      <p class="hero-tagline">{entry.excerpt}</p>
      <div class="blog-meta">
        <span class="meta-item">Published: {entry.publishDate}</span>
        {entry.lastUpdated && entry.lastUpdated !== entry.publishDate && (
          <span class="meta-item">Updated: {entry.lastUpdated}</span>
        )}
        <span class="meta-item">{entry.readingTime} min read</span>
      </div>
      {entry.tags && entry.tags.length > 0 && (
        <div class="tag-list">
          {entry.tags.map(tag => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
    </header>

    <div class="page-layout">
      <main class="page-main">

        {entry.sections.map(section => (
          <section class="content-section">
            <h2>{section.heading}</h2>
            <p>{section.body}</p>
          </section>
        ))}

        {entry.relatedSlugs && entry.relatedSlugs.length > 0 && (
          <section class="content-section">
            <h2>Related Articles</h2>
            <div class="related-links">
              {entry.relatedSlugs.map(slug => (
                <a href={`/${slug}/`} class="related-link">{slug.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase())}</a>
              ))}
            </div>
          </section>
        )}

        <FAQ faqs={entry.faqs} heading={`${entry.title} — FAQ`} />

      </main>

      <aside class="page-sidebar">
        <CTABanner
          heading="Need Pharma Career Support?"
          body={`Get expert guidance for ${entry.category} needs. Interview preparation, job support, and profile engineering available.`}
          ctaLabel="Get Pharma Job Support"
          ctaHref={site.whatsappUrl}
          secondaryLabel="View all pharma proxy services"
          secondaryHref="/pharma-proxy-job-support/"
        />
      </aside>
    </div>

    <footer class="page-disclaimer">
      <p>Pharma Job Support provides professional guidance, proxy-style job support, interview preparation, profile positioning, and domain learning support. We do not guarantee jobs, interview outcomes, or claim affiliation with any employer, pharma company, regulator, or certification body.</p>
    </footer>
  </div>
</BaseLayout>

<style>
.blog-meta { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 12px; font-size: 0.85rem; color: var(--color-text-muted, #666); }
.meta-item { display: inline-block; }
.tag-list { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
.tag { display: inline-block; background: var(--color-surface-2, #f0f4f8); color: var(--color-text, #1e3448); padding: 4px 10px; border-radius: 4px; font-size: 0.8rem; font-weight: 500; }
.related-links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
.related-link { display: inline-block; background: var(--color-surface-2, #f0f4f8); color: var(--color-text, #1e3448); padding: 6px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: 500; text-decoration: none; }
.related-link:hover { background: var(--color-primary-light, #e0f2f1); }
.page-disclaimer { margin-top: 40px; padding: 16px; background: var(--color-surface-2, #f8fafc); border-radius: 8px; font-size: 0.8rem; color: var(--color-text-muted, #666); }
</style>
