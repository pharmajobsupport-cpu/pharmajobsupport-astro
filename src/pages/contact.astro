---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';
import { buildBreadcrumbSchema } from '../utils/schema';

const schema = buildBreadcrumbSchema([
  { name: 'Home', url: site.url + '/' },
  { name: 'Contact', url: site.url + '/contact/' },
]);
---

<BaseLayout
  title="Contact Pharma Job Support | WhatsApp +91-9660834611"
  description="Contact PharmaCDM for pharma proxy job support, interview preparation, or profile engineering. WhatsApp +91-9660834611 or email support@pharmajobsupport.com."
  schema={schema}
>
  <div class="contact-container">
    <Breadcrumbs crumbs={[{ label: 'Contact' }]} />

    <div class="contact-layout">
      <div class="contact-info">
        <h1 class="contact-h1">Contact Pharma Job Support</h1>
        <p class="contact-intro">
          Get in touch for pharma proxy job support, interview preparation, or profile engineering. Our domain experts respond quickly — usually within a few hours.
        </p>

        <div class="contact-methods">
          <div class="contact-card contact-card--wa">
            <h2>WhatsApp (Fastest)</h2>
            <p>Message us directly for immediate assistance. Available 24/7 for all pharma domains.</p>
            <a
              href={site.whatsappUrl}
              class="contact-btn contact-btn--wa"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              WhatsApp: {site.whatsapp}
            </a>
          </div>

          <div class="contact-card">
            <h2>Email</h2>
            <p>For detailed inquiries, proposals, or sensitive information. We respond within 24 hours.</p>
            <a href={`mailto:${site.email}`} class="contact-btn contact-btn--email">
              {site.email}
            </a>
          </div>
        </div>

        <div class="contact-domains">
          <h2>We Support These Pharma Domains</h2>
          <ul class="domain-list" role="list">
            <li>Clinical SAS Programming (SDTM, ADaM, TLF, Pinnacle 21)</li>
            <li>Pharmacovigilance (Argus Safety, ICSR, SUSAR, EudraVigilance)</li>
            <li>Regulatory Affairs (eCTD, NDA, BLA, MAA, Veeva Vault RIM)</li>
            <li>Computer System Validation (21 CFR Part 11, GAMP 5, IQ/OQ/PQ)</li>
            <li>Veeva Vault (QMS, eTMF, RIM, Safety, EDC)</li>
            <li>Clinical Data Management (Medidata Rave, Oracle InForm, EDC)</li>
            <li>Medical Device QA (ISO 13485, EU MDR, FDA 510(k), PMA)</li>
            <li>Quality Assurance / GMP (CAPA, deviations, audit readiness)</li>
            <li>Pharma AI / ML (drug discovery, PV automation, clinical AI)</li>
            <li>RPA / Automation (UiPath, Automation Anywhere, Blue Prism)</li>
            <li>Interview Proxy Support (all pharma domains)</li>
            <li>Profile Engineering (resume, LinkedIn, career marketing)</li>
          </ul>
        </div>
      </div>

      <div class="contact-sidebar">
        <div class="contact-sidebar-card">
          <h3>Quick Response Times</h3>
          <ul role="list">
            <li>WhatsApp — within hours</li>
            <li>Email — within 24 hours</li>
            <li>Emergency support — same day</li>
          </ul>
        </div>
        <div class="contact-sidebar-card">
          <h3>Global Coverage</h3>
          <p>Support available in USA, UK, EU, Canada, Australia, Singapore, UAE, India, and 30+ countries. All major timezones.</p>
        </div>
        <div class="contact-sidebar-card">
          <h3>Confidential</h3>
          <p>We never contact your employer or retain project information. All communications are encrypted.</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-container {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-14);
  }
  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: var(--space-12);
    margin-top: var(--space-6);
    align-items: start;
  }
  .contact-h1 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 800;
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }
  .contact-intro {
    font-size: 1.1rem;
    color: var(--color-muted);
    line-height: 1.7;
    margin-bottom: var(--space-8);
  }
  .contact-methods { display: flex; flex-direction: column; gap: var(--space-5); margin-bottom: var(--space-10); }
  .contact-card {
    padding: var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
  }
  .contact-card--wa { border-color: #25D366; background: #f0fdf4; }
  .contact-card h2 { font-size: 1.1rem; font-weight: 700; margin-bottom: var(--space-2); }
  .contact-card p { font-size: 0.9rem; color: var(--color-muted); margin-bottom: var(--space-4); line-height: 1.6; }
  .contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.25rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .contact-btn--wa { background: #25D366; color: #fff; }
  .contact-btn--email { background: var(--color-primary); color: #fff; }

  .contact-domains h2 { font-size: 1.2rem; font-weight: 700; margin-bottom: var(--space-4); }
  .domain-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .domain-list li {
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
    color: var(--color-text);
  }
  .domain-list li::before { content: '✓ '; color: var(--color-primary); font-weight: 700; }

  .contact-sidebar { position: sticky; top: 5rem; display: flex; flex-direction: column; gap: var(--space-4); }
  .contact-sidebar-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-5);
  }
  .contact-sidebar-card h3 { font-size: 0.9375rem; font-weight: 700; margin-bottom: var(--space-3); }
  .contact-sidebar-card ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-1); }
  .contact-sidebar-card li { font-size: 0.8125rem; color: var(--color-muted); }
  .contact-sidebar-card li::before { content: '✓ '; color: var(--color-primary); }
  .contact-sidebar-card p { font-size: 0.8125rem; color: var(--color-muted); line-height: 1.6; }

  @media (max-width: 900px) {
    .contact-layout { grid-template-columns: 1fr; }
    .contact-sidebar { position: static; }
  }
</style>
