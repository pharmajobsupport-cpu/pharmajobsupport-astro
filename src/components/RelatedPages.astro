---
interface RelatedLink {
  href: string;
  title: string;
  description?: string;
}

interface Props {
  links: RelatedLink[];
  heading?: string;
}

const { links, heading = 'Related Services' } = Astro.props;
---

{links.length > 0 && (
  <aside class="related-pages" aria-labelledby="related-heading">
    <h2 id="related-heading" class="related-heading">{heading}</h2>
    <ul class="related-list" role="list">
      {links.map((link) => (
        <li class="related-item">
          <a href={link.href} class="related-link">
            <span class="related-title">{link.title}</span>
            {link.description && (
              <span class="related-desc">{link.description}</span>
            )}
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}

<style>
  .related-pages {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-6);
    margin-top: var(--space-10);
  }
  .related-heading {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }
  .related-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .related-link {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    text-decoration: none;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    transition: border-color 0.15s;
  }
  .related-link:hover { border-color: var(--color-primary); }
  .related-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary);
  }
  .related-desc {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
</style>
