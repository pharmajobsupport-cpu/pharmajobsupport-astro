---
import type { ServiceEntry } from '../data/services-index';

interface Props {
  services: ServiceEntry[];
  heading?: string;
  cols?: 2 | 3 | 4;
}

const { services, heading, cols = 3 } = Astro.props;
---

{heading && <h2 class="grid-heading">{heading}</h2>}

<ul class={`service-grid service-grid--${cols}`} role="list">
  {services.map((svc) => (
    <li class="service-card">
      <a href={`/${svc.slug}/`} class="service-card-link">
        <div class="service-card-body">
          <p class="service-card-category">{svc.category}</p>
          <h3 class="service-card-title">{svc.title}</h3>
          <p class="service-card-intro">{svc.heroIntro.slice(0, 120)}…</p>
        </div>
        <div class="service-card-footer">
          <span class="service-tools">
            {svc.tools.slice(0, 3).join(' · ')}
          </span>
          <span class="service-cta">Learn more →</span>
        </div>
      </a>
    </li>
  ))}
</ul>

<style>
  .grid-heading {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: var(--space-8);
    color: var(--color-text);
  }
  .service-grid {
    display: grid;
    gap: var(--space-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .service-grid--2 { grid-template-columns: repeat(2, 1fr); }
  .service-grid--3 { grid-template-columns: repeat(3, 1fr); }
  .service-grid--4 { grid-template-columns: repeat(4, 1fr); }
  .service-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .service-card:hover { box-shadow: 0 8px 24px rgb(0 0 0 / 0.1); transform: translateY(-2px); }
  .service-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
  }
  .service-card-body { flex: 1; }
  .service-card-category {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    margin-bottom: var(--space-2);
  }
  .service-card-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-3);
    line-height: 1.35;
  }
  .service-card-intro {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }
  .service-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border);
  }
  .service-tools {
    font-size: 0.75rem;
    color: var(--color-muted);
    line-height: 1.4;
    flex: 1;
  }
  .service-cta {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .service-grid--4 { grid-template-columns: repeat(2, 1fr); }
    .service-grid--3 { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 540px) {
    .service-grid--4,
    .service-grid--3,
    .service-grid--2 { grid-template-columns: 1fr; }
  }
</style>
