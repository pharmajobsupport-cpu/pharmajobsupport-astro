---
import { site } from '../data/site';
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-main">
    <!-- Brand -->
    <div class="footer-brand">
      <div class="footer-brand-name">Pharma<em>Job</em>Support</div>
      <p class="footer-brand-desc">
        Real-time proxy job support, interview assistance, and career engineering for pharma, clinical research, regulatory affairs, medical device, pharmacovigilance, validation, and life sciences professionals worldwide.
      </p>
      <div class="footer-contacts">
        <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer" class="fc-item">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          +91 96608 34611
        </a>
        <a href={`mailto:${site.email}`} class="fc-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
          {site.email}
        </a>
      </div>
    </div>

    <!-- Job Support -->
    <div class="footer-col">
      <div class="footer-col-title">Job Support</div>
      <ul>
        <li><a href="/pharma-proxy-job-support/">Pharma Proxy Job Support</a></li>
        <li><a href="/clinical-research-proxy-job-support/">Clinical Research Support</a></li>
        <li><a href="/clinical-sas-proxy-job-support/">Clinical SAS / CDISC</a></li>
        <li><a href="/regulatory-affairs-proxy-job-support/">Regulatory Affairs / eCTD</a></li>
        <li><a href="/pharmacovigilance-proxy-job-support/">Pharmacovigilance / Argus</a></li>
        <li><a href="/veeva-vault-proxy-job-support/">Veeva Vault Support</a></li>
        <li><a href="/csv-validation-proxy-job-support/">CSV Validation / GxP</a></li>
        <li><a href="/medical-device-proxy-job-support/">Medical Device QA / MDR</a></li>
      </ul>
    </div>

    <!-- Interview & Career -->
    <div class="footer-col">
      <div class="footer-col-title">Interview &amp; Career</div>
      <ul>
        <li><a href="/pharma-proxy-interview/">Interview Proxy Support</a></li>
        <li><a href="/pharma-interview-support/">Technical Interview Prep</a></li>
        <li><a href="/pharma-interview-support/">Mock Interview Sessions</a></li>
        <li><a href="/pharma-interview-support/">HR Round Preparation</a></li>
        <li><a href="/pharma-profile-engineering/">Profile Engineering</a></li>
        <li><a href="/pharma-profile-engineering/">LinkedIn Optimization</a></li>
        <li><a href="/pharma-profile-engineering/">ATS Resume Rewrite</a></li>
        <li><a href="/pharma-career-marketing/">Career Roadmapping</a></li>
      </ul>
    </div>

    <!-- Support by Location -->
    <div class="footer-col">
      <div class="footer-col-title">Support by Location</div>
      <ul>
        <li><a href="/pharma-job-support-usa/">USA Pharma Job Support</a></li>
        <li><a href="/pharma-job-support-uk/">UK Pharma Job Support</a></li>
        <li><a href="/pharma-job-support-europe/">EU / Europe Pharma Support</a></li>
        <li><a href="/pharma-job-support-india/">India Pharma Job Support</a></li>
        <li><a href="/pharma-job-support-australia/">Australia Pharma Support</a></li>
        <li><a href="/pharma-job-support-gulf/">Gulf / UAE Pharma Support</a></li>
        <li><a href="/pharma-job-support-canada/">Canada Pharma Support</a></li>
        <li><a href="/pharma-job-support-singapore/">Singapore Pharma Support</a></li>
      </ul>
    </div>

    <!-- Resources & Company -->
    <div class="footer-col">
      <div class="footer-col-title">Resources &amp; Company</div>
      <ul>
        <li><a href="/about/">About Us</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/knowledge-base/">Knowledge Base</a></li>
        <li><a href="/pharma-domains/">Pharma Domains</a></li>
        <li><a href="/pharma-interview-support/">Interview Questions</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/privacy-policy/">Privacy Policy</a></li>
        <li><a href="/terms/">Terms of Service</a></li>
      </ul>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <p class="footer-disc">
      Pharma Job Support provides professional guidance, proxy-style job support, interview preparation, profile positioning, and domain learning support for pharma and life sciences professionals. We do not guarantee specific job outcomes, interview results, or claim affiliation with any employer, pharmaceutical company, regulatory authority, or certification body. All services are advisory and educational in nature. &copy; 2026 PharmaJobSupport.com &mdash; USA &middot; UK &middot; EU &middot; India &middot; Australia &middot; Gulf
    </p>
    <div class="footer-legal">
      <a href="/privacy-policy/">Privacy</a>
      <a href="/terms/">Terms</a>
      <a href="/contact/">Contact</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy-900);
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }
  .footer-main {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 52px 5% 34px;
    display: grid;
    grid-template-columns: 230px 1fr 1fr 1fr 1fr;
    gap: 36px;
  }
  .footer-brand-name {
    font-weight: 800;
    font-size: 1.05rem;
    color: #fff;
    margin-bottom: 9px;
    letter-spacing: -0.02em;
  }
  .footer-brand-name em {
    font-style: normal;
    color: var(--teal-300);
  }
  .footer-brand-desc {
    font-size: 0.79rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.46);
    margin-bottom: 14px;
  }
  .footer-contacts {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .fc-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.79rem;
    color: rgba(255, 255, 255, 0.58);
    text-decoration: none;
    transition: color 0.2s;
  }
  .fc-item:hover { color: var(--teal-300); }
  .fc-item svg { width: 13px; height: 13px; color: var(--teal-400); flex-shrink: 0; }
  .footer-col-title {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.38);
    margin-bottom: 13px;
  }
  .footer-col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 7px; }
  .footer-col ul li a {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.56);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-col ul li a:hover { color: var(--teal-300); }
  .footer-bottom {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 18px 5%;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 18px;
    flex-wrap: wrap;
  }
  .footer-disc {
    font-size: 0.72rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.36);
    max-width: 700px;
  }
  .footer-legal { display: flex; gap: 1.1rem; flex-shrink: 0; }
  .footer-legal a {
    font-size: 0.74rem;
    color: rgba(255, 255, 255, 0.36);
    text-decoration: none;
    transition: color 0.2s;
  }
  .footer-legal a:hover { color: rgba(255, 255, 255, 0.72); }

  @media (max-width: 1100px) {
    .footer-main { grid-template-columns: 1fr 1fr 1fr; }
    .footer-brand { grid-column: 1 / -1; }
  }
  @media (max-width: 640px) {
    .footer-main { grid-template-columns: 1fr 1fr; gap: 24px; }
    .footer-bottom { flex-direction: column; }
  }
  @media (max-width: 400px) {
    .footer-main { grid-template-columns: 1fr; }
  }
</style>
