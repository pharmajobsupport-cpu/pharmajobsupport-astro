---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQ from '../components/FAQ.astro';
import CTABanner from '../components/CTABanner.astro';
import { site } from '../data/site';
import { blogs } from '../data/blogs';
import type { BlogEntry } from '../data/blogs';
import { buildFAQSchema, buildBreadcrumbSchema, buildArticleSchema } from '../utils/schema';

interface Props {
  blog: BlogEntry;
}

const { blog } = Astro.props;

const relatedBlogs = blog.relatedSlugs
  .map((slug) => blogs.find((b) => b.slug === slug))
  .filter(Boolean) as BlogEntry[];

const schemas = [
  buildArticleSchema(blog.title, blog.excerpt, site.url + '/' + blog.slug + '/', blog.publishDate, blog.lastUpdated),
  buildFAQSchema(blog.faqs.map(f => ({ question: f.q, answer: f.a }))),
  buildBreadcrumbSchema([
    { name: 'Home', url: site.url + '/' },
    { name: 'Blog', url: site.url + '/blog/' },
    { name: blog.title, url: site.url + '/' + blog.slug + '/' },
  ]),
];
---

<BaseLayout
  title={blog.metaTitle}
  description={blog.metaDesc}
  schema={schemas}
>
  <div class="blog-page-container">
    <Breadcrumbs crumbs={[
      { label: 'Blog', href: '/blog/' },
      { label: blog.category },
      { label: blog.title },
    ]} />

    <div class="blog-layout">
      <article class="blog-article" itemscope itemtype="https://schema.org/Article">
        <header class="blog-article-header">
          <div class="blog-meta">
            <span class="blog-category-label">{blog.category}</span>
            <time datetime={blog.publishDate} class="blog-date">
              {new Date(blog.publishDate).toLocaleDateString('en-USA', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <span class="blog-read">{blog.readingTime} min read</span>
          </div>
          <h1 class="blog-h1" itemprop="headline">{blog.title}</h1>
          <p class="blog-excerpt" itemprop="description">{blog.excerpt}</p>
          <div class="blog-tags">
            {blog.tags.map((tag) => (
              <span class="blog-tag-pill">{tag}</span>
            ))}
          </div>
        </header>

        <!-- Sections -->
        {blog.sections.map((section) => (
          <section class="blog-section">
            <h2>{section.heading}</h2>
            <p>{section.body}</p>
          </section>
        ))}

        <!-- FAQs -->
        {blog.faqs.length > 0 && <FAQ faqs={blog.faqs} />}

        <!-- In-article CTA -->
        <div class="blog-inline-cta">
          <p>
            <strong>Struggling with this in your current role?</strong> Get real-time expert guidance from a pharma domain specialist. Message us on WhatsApp: <a href={site.whatsappUrl} target="_blank" rel="noopener noreferrer">{site.whatsapp}</a>
          </p>
        </div>

        <!-- Author / update info -->
        <footer class="blog-article-footer">
          <p class="blog-updated">Last updated: <time datetime={blog.lastUpdated}>{new Date(blog.lastUpdated).toLocaleDateString('en-USA', { year: 'numeric', month: 'long', day: 'numeric' })}</time></p>
        </footer>
      </article>

      <!-- Sidebar -->
      <aside class="blog-sidebar">
        <div class="blog-sidebar-cta">
          <h3>Pharma Job Support</h3>
          <p>Expert guidance in {blog.category}. Real-time support via WhatsApp.</p>
          <a href={site.whatsappUrl} class="sidebar-wa-btn" target="_blank" rel="noopener noreferrer">
            {site.whatsapp}
          </a>
          <a href={`mailto:${site.email}`} class="sidebar-email">{site.email}</a>
        </div>

        {relatedBlogs.length > 0 && (
          <div class="blog-related">
            <h3>Related Articles</h3>
            <ul role="list">
              {relatedBlogs.map((r) => (
                <li>
                  <a href={`/${r.slug}/`} class="blog-related-link">
                    <span class="blog-related-cat">{r.category}</span>
                    {r.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </aside>
    </div>
  </div>

  <CTABanner variant="surface" heading="Need Expert Pharma Job Support?" />
</BaseLayout>

<style>
  .blog-page-container {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-10);
  }
  .blog-layout {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: var(--space-12);
    align-items: start;
    margin-top: var(--space-6);
  }
  .blog-article-header {
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-8);
  }
  .blog-meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }
  .blog-category-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--color-primary);
    background: var(--color-primary-light);
    padding: 0.15rem 0.5rem;
    border-radius: 2rem;
  }
  .blog-date, .blog-read { font-size: 0.8rem; color: var(--color-muted); }
  .blog-h1 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }
  .blog-excerpt {
    font-size: 1.1rem;
    color: var(--color-muted);
    line-height: 1.7;
    margin-bottom: var(--space-5);
  }
  .blog-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .blog-tag-pill {
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
    border-radius: 2rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-muted);
  }
  .blog-section { margin-bottom: var(--space-10); }
  .blog-section h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-border);
  }
  .blog-section p { font-size: 0.9375rem; color: var(--color-muted); line-height: 1.75; }

  .blog-inline-cta {
    background: var(--color-primary-light);
    border-left: 4px solid var(--color-primary);
    padding: var(--space-5);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    margin: var(--space-8) 0;
    font-size: 0.9375rem;
    line-height: 1.6;
  }
  .blog-inline-cta a { color: var(--color-primary); font-weight: 600; }
  .blog-article-footer { border-top: 1px solid var(--color-border); padding-top: var(--space-5); margin-top: var(--space-8); }
  .blog-updated { font-size: 0.8125rem; color: var(--color-muted); }

  .blog-sidebar { position: sticky; top: 5rem; display: flex; flex-direction: column; gap: var(--space-5); }
  .blog-sidebar-cta {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-5);
  }
  .blog-sidebar-cta h3 { font-size: 0.9375rem; font-weight: 700; margin-bottom: var(--space-2); }
  .blog-sidebar-cta p { font-size: 0.8125rem; color: var(--color-muted); margin-bottom: var(--space-4); line-height: 1.6; }
  .sidebar-wa-btn {
    display: block;
    background: #25D366;
    color: #fff;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 0.8125rem;
    text-decoration: none;
    text-align: center;
    margin-bottom: var(--space-2);
  }
  .sidebar-email {
    display: block;
    font-size: 0.75rem;
    color: var(--color-primary);
    text-align: center;
    text-decoration: none;
  }
  .blog-related {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-5);
  }
  .blog-related h3 { font-size: 0.875rem; font-weight: 700; margin-bottom: var(--space-4); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-muted); }
  .blog-related ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-2); }
  .blog-related-link {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.8125rem;
    font-weight: 500;
    padding: var(--space-2);
    border-radius: var(--radius-sm);
  }
  .blog-related-link:hover { color: var(--color-primary); background: var(--color-bg); }
  .blog-related-cat { font-size: 0.7rem; color: var(--color-accent); font-weight: 700; text-transform: uppercase; }

  @media (max-width: 900px) {
    .blog-layout { grid-template-columns: 1fr; }
    .blog-sidebar { position: static; }
  }
</style>
