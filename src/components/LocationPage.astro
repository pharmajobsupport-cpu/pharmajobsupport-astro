---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQ from '../components/FAQ.astro';
import CTABanner from '../components/CTABanner.astro';
import Disclaimer from '../components/Disclaimer.astro';
import StructuredData from '../components/StructuredData.astro';
import { site } from '../data/site';
import type { LocationEntry } from '../data/locations-index';
import { buildFAQSchema, buildBreadcrumbSchema } from '../utils/schema';

interface Props {
  location: LocationEntry;
}

const { location } = Astro.props;

const schemas = [
  buildFAQSchema(location.faqs.map(f => ({ question: f.q, answer: f.a }))),
  buildBreadcrumbSchema([
    { name: 'Home', url: site.url + '/' },
    { name: 'Pharma Job Support by Location', url: site.url + '/pharma-job-support/' },
    { name: location.city, url: site.url + '/' + location.slug + '/' },
  ]),
];
---

<BaseLayout
  title={location.metaTitle}
  description={location.metaDesc}
  schema={schemas}
>

  <!-- ── DARK HERO BANNER ───────────────────────────────────────────────── -->
  <section class="loc-hero" aria-labelledby="loc-h1">
    <div class="loc-glow-tr" aria-hidden="true"></div>
    <div class="loc-glow-bl" aria-hidden="true"></div>
    <div class="loc-grid-overlay" aria-hidden="true"></div>

    <div class="loc-hero-inner">

      <!-- Copy column -->
      <div class="loc-hero-copy">
        <p class="loc-eyebrow">
          <span aria-hidden="true">✦</span>
          Pharma Proxy Job Support &middot; {location.region} &middot; {location.country}
        </p>

        <h1 id="loc-h1" class="loc-h1">{location.h1}</h1>

        <p class="loc-tagline">{location.heroIntro}</p>

        <div class="loc-cta-row">
          <a
            href={site.whatsappUrl}
            class="loc-btn-wa"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Get {location.city} Pharma Support
          </a>
          <a href={`mailto:${site.email}`} class="loc-btn-ghost">Email Us</a>
        </div>

        <!-- Trust strip: visible on mobile/tablet, hidden on desktop (shown in metrics card) -->
        <div class="loc-trust-strip" aria-label="Trust indicators">
          <div class="loc-trust-item">
            <span class="loc-trust-stat">500<sup>+</sup></span>
            <span class="loc-trust-label">Pharma Pros Helped</span>
          </div>
          <div class="loc-trust-sep" aria-hidden="true"></div>
          <div class="loc-trust-item">
            <span class="loc-trust-stat">24/7</span>
            <span class="loc-trust-label">Available</span>
          </div>
          <div class="loc-trust-sep" aria-hidden="true"></div>
          <div class="loc-trust-item">
            <span class="loc-trust-stat">18<sup>+</sup></span>
            <span class="loc-trust-label">Pharma Domains</span>
          </div>
          <div class="loc-trust-sep" aria-hidden="true"></div>
          <div class="loc-trust-item">
            <span class="loc-trust-stat">65<sup>+</sup></span>
            <span class="loc-trust-label">Countries Served</span>
          </div>
        </div>
      </div>

      <!-- Metrics card: desktop only, right column -->
      <aside class="loc-metrics-card" aria-label="Key metrics">
        <div class="loc-metric-cell">
          <span class="loc-metric-stat">500<sup>+</sup></span>
          <span class="loc-metric-label">Pharma Pros Helped</span>
        </div>
        <div class="loc-metric-cell">
          <span class="loc-metric-stat">24/7</span>
          <span class="loc-metric-label">Availability</span>
        </div>
        <div class="loc-metric-cell">
          <span class="loc-metric-stat">18<sup>+</sup></span>
          <span class="loc-metric-label">Pharma Domains</span>
        </div>
        <div class="loc-metric-cell">
          <span class="loc-metric-stat">65<sup>+</sup></span>
          <span class="loc-metric-label">Countries Served</span>
        </div>
      </aside>

    </div>
  </section>

  <!-- ── BODY CONTENT ───────────────────────────────────────────────────── -->
  <div class="location-page-container">
    <Breadcrumbs crumbs={[
      { label: 'Pharma Job Support by Location', href: '/pharma-job-support/' },
      { label: location.city },
    ]} />

    <div class="location-body">
      <div class="location-main">

        <!-- Pharma context -->
        <section aria-labelledby="context-heading">
          <h2 id="context-heading">Pharma Industry in {location.city}</h2>
          <p>{location.pharmaContext}</p>
        </section>

        <!-- Top employers -->
        {location.topEmployers.length > 0 && (
          <section aria-labelledby="employers-heading">
            <h2 id="employers-heading">Major Pharma Employers in {location.city}</h2>
            <div class="employer-tags">
              {location.topEmployers.map((emp) => (
                <span class="employer-tag">{emp}</span>
              ))}
            </div>
          </section>
        )}

        <!-- Dominant domains -->
        {location.dominantDomains.length > 0 && (
          <section aria-labelledby="domains-heading">
            <h2 id="domains-heading">Top Pharma Roles We Support in {location.city}</h2>
            <div class="domain-tags">
              {location.dominantDomains.map((domain) => (
                <span class="domain-tag">{domain}</span>
              ))}
            </div>
          </section>
        )}

        <!-- Internal links to services -->
        <section aria-labelledby="services-heading">
          <h2 id="services-heading">Pharma Proxy Job Support Services for {location.city} Professionals</h2>
          <ul class="location-service-links" role="list">
            <li><a href="/clinical-data-management-proxy-job-support/">Clinical Data Management Proxy Support</a></li>
            <li><a href="/pharmacovigilance-proxy-job-support/">Pharmacovigilance Proxy Support</a></li>
            <li><a href="/regulatory-affairs-proxy-job-support/">Regulatory Affairs Proxy Support</a></li>
            <li><a href="/pharma-validation-proxy-job-support/">CSV Validation Proxy Support</a></li>
            <li><a href="/veeva-vault-proxy-job-support/">Veeva Vault Proxy Support</a></li>
            <li><a href="/clinical-sas-proxy-job-support/">Clinical SAS Programming Proxy Support</a></li>
            <li><a href="/pharma-qa-proxy-job-support/">QA / GMP Compliance Proxy Support</a></li>
            <li><a href="/pharma-interview-proxy-support/">Pharma Interview Proxy Support</a></li>
          </ul>
        </section>

        <FAQ faqs={location.faqs} heading={`Pharma Job Support in ${location.city} — FAQs`} />
        <Disclaimer compact />
      </div>

      <!-- Sidebar -->
      <aside class="location-sidebar">
        <div class="location-sidebar-card">
          <h3>Remote Support for {location.city}</h3>
          <p>All support is delivered 100% remotely. Connect with our experts wherever you are in {location.city} or {location.country}.</p>
          <a
            href={site.whatsappUrl}
            class="sidebar-wa-btn"
            target="_blank"
            rel="noopener noreferrer"
          >
            WhatsApp: {site.whatsapp}
          </a>
          <a href={`mailto:${site.email}`} class="sidebar-email-link">{site.email}</a>
        </div>
      </aside>
    </div>
  </div>

  <CTABanner
    heading={`Pharma Proxy Job Support in ${location.city}`}
    body={`Expert real-time guidance for pharma professionals based in ${location.city}. All support delivered remotely. Available 24/7.`}
  />
</BaseLayout>

<style>
  /* ── DARK HERO ──────────────────────────────────────────────────────── */
  .loc-hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(148deg, #040E1C 0%, #071829 18%, #0A2540 36%, #0D3B5E 55%, #0E6E8C 75%, #0B9BAA 100%);
    padding: clamp(3rem, 6vw, 5.5rem) 5% clamp(2.5rem, 5vw, 4.5rem);
  }
  .loc-glow-tr {
    position: absolute;
    width: 900px; height: 900px;
    top: -200px; right: -250px;
    background: radial-gradient(circle, rgba(0,191,179,0.12) 0%, transparent 65%);
    pointer-events: none;
    z-index: 0;
  }
  .loc-glow-bl {
    position: absolute;
    width: 600px; height: 600px;
    bottom: -100px; left: -120px;
    background: radial-gradient(circle, rgba(11,154,170,0.16) 0%, transparent 62%);
    pointer-events: none;
    z-index: 0;
  }
  .loc-grid-overlay {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,191,179,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,191,179,0.03) 1px, transparent 1px);
    background-size: 52px 52px;
    pointer-events: none;
    z-index: 0;
  }

  .loc-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 1024px) {
    .loc-hero-inner {
      grid-template-columns: minmax(0, 1fr) minmax(240px, 320px);
      gap: clamp(2rem, 3vw, 3rem);
    }
  }

  .loc-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.71rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal-300);
    margin-bottom: 1rem;
  }

  .loc-h1 {
    font-size: clamp(1.7rem, 3.5vw, 2.75rem) !important;
    font-weight: 800 !important;
    line-height: 1.18 !important;
    color: #ffffff !important;
    letter-spacing: -0.025em !important;
    margin-bottom: 1rem;
    max-width: 680px;
  }

  .loc-tagline {
    font-size: clamp(0.95rem, 1.4vw, 1.06rem);
    color: rgba(255, 255, 255, 0.78);
    line-height: 1.75;
    max-width: 620px;
    margin-bottom: 1.75rem;
  }

  .loc-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-bottom: 2rem;
  }
  .loc-btn-wa {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: #1DAA61;
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 700;
    padding: 0.8rem 1.5rem;
    border-radius: 7px;
    text-decoration: none;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    box-shadow: 0 4px 20px rgba(29, 170, 97, 0.45);
    white-space: nowrap;
  }
  .loc-btn-wa:hover {
    background: #18954f;
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(29, 170, 97, 0.55);
    color: #ffffff;
  }
  .loc-btn-ghost {
    display: inline-flex;
    align-items: center;
    background: transparent;
    color: rgba(255, 255, 255, 0.85);
    font-size: 0.88rem;
    font-weight: 600;
    padding: 0.8rem 1.5rem;
    border-radius: 7px;
    border: 1.5px solid rgba(255, 255, 255, 0.3);
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s, color 0.2s;
    white-space: nowrap;
  }
  .loc-btn-ghost:hover {
    border-color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.07);
    color: #fff;
  }

  /* Trust strip — visible on mobile/tablet only */
  .loc-trust-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1.5rem;
    padding: 1rem 1.1rem;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 10px;
  }
  @media (min-width: 1024px) {
    .loc-trust-strip { display: none; }
  }
  .loc-trust-item {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .loc-trust-stat {
    font-size: 1.3rem;
    font-weight: 800;
    color: var(--teal-300);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .loc-trust-stat sup {
    font-size: 0.68rem;
    color: var(--teal-400);
    font-weight: 700;
  }
  .loc-trust-label {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.55);
    font-weight: 500;
    letter-spacing: 0.03em;
  }
  .loc-trust-sep {
    width: 1px;
    height: 2rem;
    background: rgba(255, 255, 255, 0.15);
    flex-shrink: 0;
  }

  /* Metrics card — desktop right column only */
  .loc-metrics-card {
    display: none;
  }
  @media (min-width: 1024px) {
    .loc-metrics-card {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
      padding: 1.2rem 1rem;
      border-radius: 16px;
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(255, 255, 255, 0.05);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
      align-self: center;
    }
  }
  .loc-metric-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0.85rem 0.5rem;
    border-radius: 10px;
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.08);
    min-height: 5rem;
  }
  .loc-metric-stat {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--teal-300);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }
  .loc-metric-stat sup {
    font-size: 0.68rem;
    color: var(--teal-400);
    font-weight: 700;
  }
  .loc-metric-label {
    font-size: 0.69rem;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 500;
    line-height: 1.3;
    margin-top: 0.35rem;
    letter-spacing: 0.02em;
  }

  /* ── BODY ────────────────────────────────────────────────────────────── */
  .location-page-container {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-10);
  }
  .location-body {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: var(--space-12);
    align-items: start;
  }
  .location-main section {
    margin-bottom: var(--space-10);
  }
  .location-main h2 {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }
  .location-main p { font-size: 1rem; color: var(--color-muted); line-height: 1.7; }
  .employer-tags, .domain-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .employer-tag {
    font-size: 0.8125rem;
    padding: 0.25rem 0.75rem;
    border-radius: 2rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-weight: 500;
  }
  .domain-tag {
    font-size: 0.8125rem;
    padding: 0.25rem 0.75rem;
    border-radius: 2rem;
    background: var(--color-primary-light);
    border: 1px solid var(--color-primary);
    color: var(--color-primary);
    font-weight: 600;
  }
  .location-service-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .location-service-links a {
    display: block;
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-primary);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: border-color 0.15s;
  }
  .location-service-links a:hover { border-color: var(--color-primary); }

  .location-sidebar { position: sticky; top: 5rem; }
  .location-sidebar-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-6);
  }
  .location-sidebar-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: var(--space-2); }
  .location-sidebar-card p { font-size: 0.875rem; color: var(--color-muted); margin-bottom: var(--space-4); line-height: 1.6; }
  .sidebar-wa-btn {
    display: block;
    background: #25D366;
    color: #fff;
    padding: 0.625rem 1rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 0.875rem;
    text-decoration: none;
    text-align: center;
    margin-bottom: var(--space-3);
  }
  .sidebar-email-link {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-primary);
    text-align: center;
    text-decoration: none;
  }
  .sidebar-email-link:hover { text-decoration: underline; }

  /* ── Mobile ──────────────────────────────────────────────────────────── */
  @media (max-width: 768px) {
    .loc-hero { padding: 2rem 1.25rem 2.5rem; }
    .loc-cta-row { flex-direction: column; gap: 0.6rem; }
    .loc-btn-wa, .loc-btn-ghost {
      width: 100%;
      justify-content: center;
      min-height: 52px;
      font-size: 1rem;
      border-radius: 10px;
    }
    .loc-h1 { max-width: none !important; }
    .loc-tagline { max-width: none; }
  }
  @media (max-width: 900px) {
    .location-body { grid-template-columns: 1fr; }
    .location-sidebar { position: static; }
  }
</style>
