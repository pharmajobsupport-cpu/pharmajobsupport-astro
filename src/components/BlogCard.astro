---
import type { BlogEntry } from '../data/blogs';

interface Props {
  blog: BlogEntry;
}

const { blog } = Astro.props;
---

<article class="blog-card">
  <a href={`/${blog.slug}/`} class="blog-card-link">
    <div class="blog-card-meta">
      <span class="blog-category">{blog.category}</span>
      <span class="blog-date">{new Date(blog.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
      <span class="blog-read">{blog.readingTime} min read</span>
    </div>
    <h2 class="blog-card-title">{blog.title}</h2>
    <p class="blog-card-excerpt">{blog.excerpt}</p>
    <div class="blog-card-tags">
      {blog.tags.slice(0, 3).map((tag) => (
        <span class="blog-tag">{tag}</span>
      ))}
    </div>
    <span class="blog-card-cta">Read article →</span>
  </a>
</article>

<style>
  .blog-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .blog-card:hover { box-shadow: 0 8px 24px rgb(0 0 0 / 0.09); transform: translateY(-2px); }
  .blog-card-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
    height: 100%;
  }
  .blog-card-meta {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    flex-wrap: wrap;
  }
  .blog-category {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    background: var(--color-primary-light);
    padding: 0.15rem 0.5rem;
    border-radius: 2rem;
  }
  .blog-date, .blog-read {
    font-size: 0.8rem;
    color: var(--color-muted);
  }
  .blog-card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.35;
  }
  .blog-card-excerpt {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.6;
    flex: 1;
  }
  .blog-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .blog-tag {
    font-size: 0.75rem;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    padding: 0.1rem 0.5rem;
    border-radius: 2rem;
    background: var(--color-surface);
  }
  .blog-card-cta {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
  }
</style>
