---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQ from '../components/FAQ.astro';
import CTABanner from '../components/CTABanner.astro';
import RelatedPages from '../components/RelatedPages.astro';
import ProxyKeywordSection from '../components/ProxyKeywordSection.astro';
import Disclaimer from '../components/Disclaimer.astro';
import StructuredData from '../components/StructuredData.astro';
import { site } from '../data/site';
import { allServices } from '../data/services-index';
import type { ServiceEntry } from '../data/services-index';
import { buildServiceSchema, buildFAQSchema, buildBreadcrumbSchema } from '../utils/schema';

interface Props {
  service: ServiceEntry;
}

const { service } = Astro.props;

const relatedServices = service.relatedSlugs
  .map((slug) => allServices.find((s) => s.slug === slug))
  .filter(Boolean) as ServiceEntry[];

const relatedLinks = relatedServices.map((s) => ({
  href: `/${s.slug}/`,
  title: s.title,
  description: s.heroIntro.slice(0, 100) + '…',
}));

const breadcrumbs = [
  { label: 'Services', href: '/pharma-proxy-job-support/' },
  { label: service.title },
];

const schemas = [
  buildServiceSchema(service),
  buildFAQSchema(service.faqs.map(f => ({ question: f.q, answer: f.a }))),
  buildBreadcrumbSchema([
    { name: 'Home', url: site.url + '/' },
    { name: 'Services', url: site.url + '/pharma-proxy-job-support/' },
    { name: service.title, url: site.url + '/' + service.slug + '/' },
  ]),
];
---

<BaseLayout
  title={service.metaTitle}
  description={service.metaDesc}
  schema={schemas}
>
  <div class="service-page">
    <div class="service-page-container">
      <Breadcrumbs crumbs={breadcrumbs} />

      <!-- Hero section -->
      <header class="service-hero">
        <p class="service-category-label">{service.category}</p>
        <h1 class="service-h1">{service.h1}</h1>
        <p class="service-intro">{service.heroIntro}</p>
        <div class="service-hero-actions">
          <a
            href={site.whatsappUrl}
            class="btn-wa"
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Get {service.category} Support Now
          </a>
          <a href="/contact/" class="btn-secondary">Email Us</a>
        </div>
      </header>

      <div class="service-body">
        <div class="service-main">
          <!-- Problem section -->
          <section class="service-problem" aria-labelledby="problem-heading">
            <h2 id="problem-heading">The Challenge</h2>
            <p>{service.problemSection}</p>
          </section>

          <!-- What's covered -->
          <section class="service-covered" aria-labelledby="covered-heading">
            <h2 id="covered-heading">What Our Support Covers</h2>
            <ul class="covered-list" role="list">
              {service.whatCovered.map((item) => (
                <li>
                  <span class="covered-check" aria-hidden="true">✓</span>
                  {item}
                </li>
              ))}
            </ul>
          </section>

          <!-- Tools -->
          {service.tools.length > 0 && (
            <section class="service-tools-section" aria-labelledby="tools-heading">
              <h2 id="tools-heading">Tools & Platforms We Support</h2>
              <div class="tools-list">
                {service.tools.map((tool) => (
                  <span class="tool-tag">{tool}</span>
                ))}
              </div>
            </section>
          )}

          <!-- Role examples -->
          {service.roleExamples.length > 0 && (
            <section class="service-roles" aria-labelledby="roles-heading">
              <h2 id="roles-heading">Role Titles We Support</h2>
              <div class="roles-list">
                {service.roleExamples.map((role) => (
                  <span class="role-tag">{role}</span>
                ))}
              </div>
            </section>
          )}

          <!-- FAQs -->
          <FAQ faqs={service.faqs} />

          <!-- Proxy keyword section -->
          <ProxyKeywordSection domain={service.category} />

          <!-- Disclaimer -->
          <Disclaimer compact />
        </div>

        <!-- Sidebar -->
        <aside class="service-sidebar">
          <div class="sidebar-cta-card">
            <h3>Need Immediate Support?</h3>
            <p>Connect with a {service.category} expert right now via WhatsApp.</p>
            <a
              href={site.whatsappUrl}
              class="sidebar-wa-btn"
              target="_blank"
              rel="noopener noreferrer"
            >
              WhatsApp: {site.whatsapp}
            </a>
            <a href={`mailto:${site.email}`} class="sidebar-email-link">
              {site.email}
            </a>
          </div>

          {relatedLinks.length > 0 && (
            <RelatedPages links={relatedLinks} heading="Related Services" />
          )}
        </aside>
      </div>
    </div>
  </div>

  <CTABanner
    heading={`Expert ${service.category} Proxy Job Support`}
    body={`Real-time guidance from ${service.category} specialists. Available 24/7. Message us on WhatsApp to get started.`}
  />
</BaseLayout>

<style>
  .service-page { padding: 0; }
  .service-page-container {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-10);
  }
  .service-hero {
    padding: var(--space-10) 0 var(--space-8);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-8);
  }
  .service-category-label {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin-bottom: var(--space-3);
  }
  .service-h1 {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 800;
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: var(--space-4);
  }
  .service-intro {
    font-size: 1.1rem;
    color: var(--color-muted);
    line-height: 1.7;
    max-width: 52rem;
    margin-bottom: var(--space-6);
  }
  .service-hero-actions { display: flex; gap: var(--space-4); flex-wrap: wrap; }
  .btn-wa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: #25D366;
    color: #fff;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius);
    font-weight: 700;
    text-decoration: none;
    font-size: 0.9375rem;
  }
  .btn-wa:hover { filter: brightness(1.1); }
  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius);
    font-weight: 600;
    text-decoration: none;
    font-size: 0.9375rem;
    border: 2px solid var(--color-border);
    color: var(--color-text);
  }
  .btn-secondary:hover { border-color: var(--color-primary); color: var(--color-primary); }

  .service-body {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: var(--space-12);
    align-items: start;
  }
  .service-main { min-width: 0; }
  .service-main h2 {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: var(--space-4);
    color: var(--color-text);
  }
  .service-problem, .service-covered, .service-tools-section, .service-roles {
    margin-bottom: var(--space-10);
  }
  .service-problem p { font-size: 1rem; color: var(--color-muted); line-height: 1.7; }

  .covered-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .covered-list li {
    display: flex;
    gap: var(--space-3);
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.5;
  }
  .covered-check { color: var(--color-primary); font-weight: 700; flex-shrink: 0; }

  .tools-list, .roles-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .tool-tag, .role-tag {
    font-size: 0.8125rem;
    padding: 0.25rem 0.75rem;
    border-radius: 2rem;
    border: 1px solid var(--color-border);
  }
  .tool-tag { background: var(--color-primary-light); color: var(--color-primary); font-weight: 600; }
  .role-tag { background: var(--color-surface); color: var(--color-text); }

  .service-sidebar { position: sticky; top: 5rem; }
  .sidebar-cta-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-6);
    margin-bottom: var(--space-5);
  }
  .sidebar-cta-card h3 { font-size: 1rem; font-weight: 700; margin-bottom: var(--space-2); }
  .sidebar-cta-card p { font-size: 0.875rem; color: var(--color-muted); margin-bottom: var(--space-4); }
  .sidebar-wa-btn {
    display: block;
    background: #25D366;
    color: #fff;
    padding: 0.625rem 1rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
    font-size: 0.875rem;
    text-decoration: none;
    text-align: center;
    margin-bottom: var(--space-3);
  }
  .sidebar-email-link {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-primary);
    text-align: center;
    text-decoration: none;
  }
  .sidebar-email-link:hover { text-decoration: underline; }

  @media (max-width: 900px) {
    .service-body { grid-template-columns: 1fr; }
    .service-sidebar { position: static; }
  }
</style>
