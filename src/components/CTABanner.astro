---
import { site } from '../data/site';

interface Props {
  heading?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  variant?: 'dark' | 'surface';
}

const {
  heading = 'Need Pharma Job Support Right Now?',
  body = 'Our experts are available 24/7 — USA, Canada, UK, Europe & worldwide.',
  ctaLabel = 'Get Instant Help',
  ctaHref = site.whatsappUrl,
  secondaryLabel,
  secondaryHref,
  variant = 'dark',
} = Astro.props;

const phone = site.whatsapp.replace(/[^+\d]/g, '');
---

<div class="cta-wrap">
<section class={`cta-card cta-card--${variant}`} aria-label="Call to action">
  <div class="cta-badge">EXPERT HELP AVAILABLE</div>
  <h2 class="cta-heading">{heading}</h2>
  <p class="cta-body">{body}</p>
  <div class="cta-btns">
    <a
      href={ctaHref}
      class="cta-btn cta-btn--wa"
      target={ctaHref.startsWith('http') ? '_blank' : undefined}
      rel={ctaHref.startsWith('http') ? 'noopener noreferrer' : undefined}
    >
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
      </svg>
      {ctaLabel}
    </a>
    <a href={`tel:${phone}`} class="cta-btn cta-btn--call">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.09 8.81 19.79 19.79 0 01.21 2.2 2 2 0 012.2 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.35 7.69a16 16 0 006 6l1.06-1.06a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92v2z"/>
      </svg>
      Call Now
    </a>
  </div>
  {secondaryLabel && secondaryHref && (
    <a href={secondaryHref} class="cta-secondary">{secondaryLabel}</a>
  )}
</section>
</div>

<style>
  .cta-wrap {
    max-width: var(--max-w, clamp(1380px, 80vw, 1900px));
    margin: 0 auto;
    padding: 0 5% 2rem;
  }
  .cta-card {
    border-radius: 14px;
    padding: 1.5rem;
    margin-bottom: 0;
  }
  .cta-card--dark {
    background: #062E1E;
    color: #fff;
  }
  .cta-card--surface {
    background: var(--surface-50, #f5f8fa);
    color: var(--text-700, #1e3448);
  }
  .cta-badge {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4ADE80;
    margin-bottom: 0.75rem;
  }
  .cta-card--surface .cta-badge { color: var(--teal-500); }
  .cta-heading {
    font-size: 1.05rem;
    font-weight: 800;
    line-height: 1.3;
    margin-bottom: 0.6rem;
    color: inherit;
  }
  .cta-body {
    font-size: 0.84rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: 1.1rem;
  }
  .cta-card--surface .cta-body { color: var(--text-500, #3d5166); }
  .cta-btns {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 16px;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    text-decoration: none;
    transition: opacity 0.15s;
    white-space: nowrap;
  }
  .cta-btn:active { opacity: 0.85; }
  .cta-btn svg { width: 16px; height: 16px; flex-shrink: 0; }
  .cta-btn--wa {
    background: #1DAA61;
    color: #fff;
    flex: 0 0 auto;
    justify-content: center;
  }
  .cta-btn--call {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.22);
    flex: 0 0 auto;
  }
  .cta-card--surface .cta-btn--call {
    background: var(--surface-100, #ebf1f6);
    color: var(--text-700, #1e3448);
    border-color: var(--surface-200, #d6e4ee);
  }
  .cta-secondary {
    display: block;
    margin-top: 0.85rem;
    font-size: 0.8rem;
    text-decoration: underline;
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.2s;
  }
  .cta-card--surface .cta-secondary { color: var(--text-400, #5a6e82); }
  .cta-secondary:hover { color: rgba(255, 255, 255, 0.9); }
</style>
