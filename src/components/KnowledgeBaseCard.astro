---
import type { KBEntry } from '../data/knowledgeBase-index';

interface Props {
  entry: KBEntry;
}

const { entry } = Astro.props;
---

<article class="kb-card">
  <a href={`/${entry.slug}/`} class="kb-card-link">
    <p class="kb-category">{entry.category}</p>
    <h2 class="kb-title">{entry.title}</h2>
    <p class="kb-intro">{entry.intro.slice(0, 140)}…</p>
    <div class="kb-terms">
      {entry.keyTerms.slice(0, 3).map((kt) => (
        <span class="kb-term">{kt.term}</span>
      ))}
    </div>
    <span class="kb-cta">Read guide →</span>
  </a>
</article>

<style>
  .kb-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-bg);
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .kb-card:hover { box-shadow: 0 8px 24px rgb(0 0 0 / 0.09); transform: translateY(-2px); }
  .kb-card-link {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    text-decoration: none;
    color: inherit;
    height: 100%;
  }
  .kb-category {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
  }
  .kb-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    line-height: 1.35;
  }
  .kb-intro {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.6;
    flex: 1;
  }
  .kb-terms {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .kb-term {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary);
    background: var(--color-primary-light);
    padding: 0.1rem 0.5rem;
    border-radius: 2rem;
  }
  .kb-cta {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
  }
</style>
